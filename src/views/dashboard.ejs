<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Reservation | Admin Console</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0a0a0c;
      --bg-card: rgba(255, 255, 255, 0.02);
      --glass-border: rgba(255, 255, 255, 0.08);
      --accent-primary: linear-gradient(135deg, #00f2ff 0%, #0072ff 100%);
      --text-bright: #ffffff;
      --text-dim: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: radial-gradient(circle at top right, #1a1a2e, var(--bg-dark));
      color: var(--text-bright);
      min-height: 100vh;
      padding: 40px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 40px;
    }

    .logo {
      font-weight: 800;
      font-size: 1.5rem;
      background: var(--accent-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .logout-btn {
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.9rem;
      border: 1px solid var(--glass-border);
      padding: 8px 20px;
      border-radius: 50px;
      transition: all 0.3s;
    }

    .logout-btn:hover {
      color: white;
      border-color: white;
    }

    .section-header {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--text-dim);
      margin: 40px 0 20px;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .section-header::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--glass-border);
    }

    /* Inventory Management */
    .inventory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .inventory-card {
      background: var(--bg-card);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 25px;
      backdrop-filter: blur(10px);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .product-info h4 {
      margin-bottom: 5px;
      font-weight: 600;
    }

    .product-info p {
      font-size: 0.8rem;
      color: var(--text-dim);
    }

    .inventory-form {
      display: flex;
      gap: 10px;
    }

    .inventory-input {
      width: 70px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--glass-border);
      border-radius: 8px;
      color: white;
      padding: 8px;
      text-align: center;
    }

    .update-btn {
      background: var(--accent-primary);
      border: none;
      border-radius: 8px;
      color: white;
      padding: 8px 15px;
      font-weight: 600;
      cursor: pointer;
      font-size: 0.85rem;
    }

    /* Table Styles */
    .glass-table-container {
      background: var(--bg-card);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      overflow: hidden;
      backdrop-filter: blur(10px);
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      text-align: left;
      padding: 20px;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-dim);
      border-bottom: 1px solid var(--glass-border);
    }

    td {
      padding: 20px;
      border-bottom: 1px solid var(--glass-border);
      font-size: 0.9rem;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .job-id {
      font-family: monospace;
      color: #00f2ff;
    }

    .error-msg {
      color: #ff4d4d;
      font-size: 0.8rem;
      max-width: 300px;
      display: block;
    }

    pre {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--text-dim);
    }

    .action-btns {
      display: flex;
      gap: 10px;
    }

    .action-btns button {
      padding: 6px 14px;
      border-radius: 6px;
      border: 1px solid var(--glass-border);
      background: transparent;
      color: white;
      cursor: pointer;
      font-size: 0.8rem;
      transition: all 0.2s;
    }

    .retry-btn:hover {
      background: #28a745;
      border-color: #28a745;
    }

    .cancel-btn:hover {
      background: #dc3545;
      border-color: #dc3545;
    }

    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 30px;
      gap: 20px;
    }

    .pagination a {
      color: var(--text-dim);
      text-decoration: none;
      padding: 8px 20px;
      border: 1px solid var(--glass-border);
      border-radius: 50px;
    }

    .pagination a:hover {
      color: white;
      border-color: white;
    }
  </style>
</head>

<body>
  <div class="container">
    <nav>
      <div class="logo">ADMIN-CONSOLE</div>
      <a href="/logout" class="logout-btn">Terminate Session</a>
    </nav>

    <div class="section-header">Inventory Control</div>
    <div class="inventory-grid">
      <% products.forEach(product=> { %>
        <div class="inventory-card">
          <div class="product-info">
            <h4>
              <%= product.name %>
            </h4>
            <p>Asset ID: <%= product.id %>
            </p>
          </div>
          <form action="/admin/products/<%= product.id %>/inventory" method="POST" class="inventory-form">
            <input type="number" name="inventory" value="<%= product.inventory %>" min="0" class="inventory-input">
            <button type="submit" class="update-btn">Sync</button>
          </form>
        </div>
        <% }) %>
    </div>

    <div class="section-header">Incident Reports (Failed Jobs)</div>

    <% if (jobs.length===0) { %>
      <div style="text-align: center; padding: 40px; color: var(--text-dim);">
        <p>No active incidents detected. Network is stable. ✅</p>
      </div>
      <% } else { %>
        <div class="glass-table-container">
          <table>
            <thead>
              <tr>
                <th>Job Hash</th>
                <th>Timestamp</th>
                <th>Payload</th>
                <th>Failure Logic</th>
                <th>Recovery</th>
              </tr>
            </thead>
            <tbody>
              <% jobs.forEach(job=> { %>
                <tr>
                  <td class="job-id">#<%= job.id %>
                  </td>
                  <td>
                    <%= new Date(job.finishedOn || job.timestamp).toLocaleTimeString() %>
                  </td>
                  <td>
                    <pre><%= JSON.stringify(job.data.successfulItems || {}, null, 1) %></pre>
                  </td>
                  <td><span class="error-msg">
                      <%= job.failedReason %>
                    </span></td>
                  <td>
                    <div class="action-btns">
                      <form action="/admin/jobs/<%= job.id %>/retry" method="POST">
                        <button type="submit" class="retry-btn">Retry</button>
                      </form>
                      <form action="/admin/jobs/<%= job.id %>/cancel" method="POST">
                        <button type="submit" class="cancel-btn">Drop</button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <% if (currentPage> 1) { %>
            <a href="/admin/dashboard?page=<%= currentPage - 1 %>">&larr; Back</a>
            <% } %>
              <span style="font-size: 0.8rem; color: var(--text-dim);">Index <%= currentPage %> of <%= totalPages %>
              </span>
              <% if (currentPage < totalPages) { %>
                <a href="/admin/dashboard?page=<%= currentPage + 1 %>">Forward &rarr;</a>
                <% } %>
        </div>
        <% } %>
  </div>
</body>

</html>